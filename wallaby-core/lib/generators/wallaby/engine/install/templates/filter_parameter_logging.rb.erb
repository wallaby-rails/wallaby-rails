# frozen_string_literal: true

# Be sure to restart your server when you modify this file.

# Configure sensitive parameters which will be filtered from the log file.
#
# SECURITY: Wallaby exposes generic form submission for your models. Make sure
# credential/secret attributes are filtered so they are not written to logs or
# exception reports.
Rails.application.config.filter_parameters += %i[
  password password_confirmation passwd secret token
  api_key apikey access_token refresh_token
  private_key client_secret
  credit_card card_number cvv
]
