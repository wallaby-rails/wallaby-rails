<%# @param object [model] model instance %>
<%# @param field_name [String] name of the field %>
<%# @param value [Object] value of the field %>
<%# @param metadata [Hash] metadata of the field %>
<%#
  SECURITY: the `raw` type renders model content as HTML. Sanitize it so that
  stored `<script>`/event handlers cannot execute (stored XSS).
%>
<% if value.nil? %>
  <%= null %>
<% else %>
  <%= sanitize value.to_s %>
<% end %>
